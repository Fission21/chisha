    "title": "日式肥牛丼饭",
    "titleEn": "Japanese Beef Bowl",
    "cuisine": "日式",
    "mealTypes": ["lunch", "dinner"],
    "difficulty": "中等",
    "cookTimeMin": 30,
    "servings": 2,
    "summary": "根据 HowToCook 固定版本整理的家常牛肉盖饭；营养按本地食材和克数重新推算。",
    "coverEmoji": "🍚",
