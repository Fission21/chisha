    },
    "ingredients": [
      {"name": "米饭", "ref": "米饭（蒸，代表值）", "amount": 300, "unit": "g"},
      {"name": "肥牛片", "ref": "牛肉（代表值，fat 9g）", "amount": 250, "unit": "g"},
      {"name": "白洋葱", "ref": "洋葱（鲜）[葱头]", "amount": 150, "unit": "g"},
      {"name": "葱花", "ref": "葱（小葱，鲜）", "amount": 20, "unit": "g"},
      {"name": "白芝麻", "ref": "芝麻子（白）", "amount": 5, "unit": "g"},
      {"name": "料酒", "ref": "料酒", "amount": 30, "unit": "g", "note": "替代味淋用于营养估算"},
      {"name": "酱油", "ref": "酱油", "amount": 30, "unit": "g"},
      {"name": "蚝油", "ref": "蚝油", "amount": 20, "unit": "g"},
      {"name": "白糖", "ref": "白糖", "amount": 5, "unit": "g"}
    ],
    "steps": [
      {"text": "洋葱切月牙状，小葱切段；白芝麻在干锅中小火炒至略金黄。", "durationMin": 6, "heat": "小火"},
      {"text": "料酒、酱油、蚝油、白糖调匀成酱汁；肥牛快速焯水后沥干。", "durationMin": 3},
      {"text": "锅中少油炒软洋葱，加水和酱汁煮 3 分钟，再加入肥牛翻煮至熟。", "durationMin": 13, "heat": "中火"},
      {"text": "把牛肉和汤汁铺在米饭上，撒葱花和白芝麻。", "durationMin": 2}
    ],
    "tips": ["上游做法使用味淋；此处用料酒作营养映射，实际可按口味替换。", "米饭与牛肉分开保存，复热时加少量水口感更好。"],
    "tags": ["日式", "高蛋白", "盖饭", "HowToCook"],
    "allergens": ["大豆", "芝麻"]
  },
  {
