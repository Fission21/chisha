    },
    "ingredients": [
      {"name": "米饭", "ref": "米饭（蒸，代表值）", "amount": 800, "unit": "g"},
      {"name": "鸡腿肉", "ref": "鸡腿", "amount": 500, "unit": "g"},
      {"name": "土豆", "ref": "马铃薯[土豆、洋芋]", "amount": 400, "unit": "g"},
      {"name": "胡萝卜", "ref": "胡萝卜", "amount": 200, "unit": "g"},
      {"name": "洋葱", "ref": "洋葱（鲜）[葱头]", "amount": 300, "unit": "g"},
      {"name": "咖喱粉", "ref": "咖喱粉", "amount": 30, "unit": "g", "note": "按可计算食材换算；不同咖喱块标签差异较大"},
      {"name": "葵花籽油", "ref": "葵花籽油", "amount": 15, "unit": "g"},
      {"name": "大蒜", "ref": "大蒜（白皮，鲜）[蒜头]", "amount": 12, "unit": "g"}
    ],
    "steps": [
      {"text": "洋葱、土豆、胡萝卜切块；鸡腿肉切成易熟的小块；咖喱粉备用。", "durationMin": 12},
      {"text": "热锅下油，先炒香大蒜和鸡肉，再依次加入胡萝卜、洋葱、土豆翻炒。", "durationMin": 10, "heat": "中火"},
      {"text": "加水没过食材，煮至土豆变软；关火调入咖喱粉，搅匀后小火再煮至浓稠。", "durationMin": 28, "heat": "小火"},
      {"text": "咖喱浇在热米饭上即可。", "durationMin": 2}
    ],
    "tips": ["不同品牌咖喱块的脂肪和钠差异较大，本页只按所列咖喱粉估算。", "咖喱酱和米饭可分装冷藏，复热时酱汁加少量水。"],
    "tags": ["日式", "一锅出", "咖喱", "HowToCook"],
    "allergens": []
  },
