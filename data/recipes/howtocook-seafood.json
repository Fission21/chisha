        "ref": "花生油",
        "amount": 25,
        "unit": "g",
        "note": ""
      }
    ],
    "steps": [
      {
        "text": "对虾剪须开背挑虾线，姜切丝，葱切段。",
        "durationMin": 8
      },
      {
        "text": "热锅下油，虾煎至两面变红出虾油。",
        "durationMin": 5,
        "heat": "中火"
      },
      {
        "text": "下姜丝葱段，烹料酒，加酱油、白糖、番茄酱。",
        "durationMin": 3,
        "heat": "中火"
      },
