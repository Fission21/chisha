# 全部可选；不配置则使用内置默认值（SQLite + 仓库内数据）
# DATABASE_URL=sqlite:///./var/chisha.db
# DATA_DIR=./data/processed
# WEB_DIST=./web/out
# 可选演示账户：两个变量同时设置时，首次 seed 创建账号；已有账号不会被重置。
# DEFAULT_ACCOUNT_EMAIL=demo@chisha.local
# DEFAULT_ACCOUNT_PASSWORD=replace-with-a-private-local-password
# 本地前端开发时指向后端：
# NEXT_PUBLIC_API_URL=http://localhost:8000
